# ABOUTME: systemd unit for the scientist on the Pi. Install: sudo cp to /etc/systemd/system/,
# ABOUTME: then sudo systemctl daemon-reload && sudo systemctl enable --now scientist.

[Unit]
Description=Pantone rig scientist service
After=network-online.target rig-service.service
Wants=network-online.target

[Service]
User=<user>
WorkingDirectory=/home/<user>/pantone-rig
Environment=PYTHONPATH=/home/<user>/pantone-rig/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/<user>/pantone-rig/deploy/scientist.env
ExecStart=/home/<user>/pantone-rig/.venv/bin/python -m scientist
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
